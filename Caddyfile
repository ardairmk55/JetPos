{$POSHANE_DOMAIN:poshane.net}, www.{$POSHANE_DOMAIN:poshane.net} {
	encode zstd gzip
	# Caddy istemcinin X-Forwarded-For değerini kendi gördüğü adresle değiştirir (hız sınırı bunu kullanır).
	# Django yönetim paneli kullanılmıyor; internetten erişimi kapalı.
	@admin path /admin /admin/*
	respond @admin 404

	reverse_proxy app:8000
}
