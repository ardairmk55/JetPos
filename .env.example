# Bu dosyayı sunucuda `.env` olarak kopyalayın ve değerleri doldurun. `.env` depoya EKLENMEZ.

POSHANE_DOMAIN=poshane.net

# Uzun rastgele bir değer: python -c "import secrets; print(secrets.token_urlsafe(64))"
JETPOS_SECRET_KEY=

JETPOS_HTTPS=1
JETPOS_ALLOWED_HOSTS=poshane.net,www.poshane.net
JETPOS_CSRF_ORIGINS=https://poshane.net,https://www.poshane.net

# HTTPS çalıştığı doğrulandıktan sonra 31536000 yapın (1 yıl); önce 0 bırakın.
JETPOS_HSTS_SECONDS=0

# Veritabanı varsayılan olarak /data içindeki SQLite (WAL). PostgreSQL için:
# DATABASE_URL=postgres://kullanici:parola@host:5432/poshane
